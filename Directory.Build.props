<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1707: underscores in test names; CA1848/CA1873: LoggerMessage delegates are overkill here. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1515;CA1031;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1819;CA1002;CA1716;CA1720;CA1054;CA1055;CA1056;CA1724;CA1032;CA1508;CA1860;CA1866;CA1865;CA2234</NoWarn>
  </PropertyGroup>
</Project>