{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5175",
  "Rose": {
    "DataDirectory": "data"
  },
  "Auth": {
    "SessionLifetime": "12:00:00"
  },
  "Shutdown": {
    "Enabled": false,
    "IdleTimeout": "00:00:20"
  },
  "Lingo": {
    "ModelDirectory": "models/nllb-200-distilled-600M",
    "UnloadAfterIdle": "00:10:00",
    "MaxTokens": 256
  },
  "Reminders": {
    "TickInterval": "00:00:15",
    "SchedulerEnabled": true,
    "DesktopAlarms": true,
    "PushContact": "https://github.com/chupipings1424/project-rose"
  }
}