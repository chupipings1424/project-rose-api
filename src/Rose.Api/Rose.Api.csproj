<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public type needs an XML comment. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>project-rose-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rose.Infrastructure\Rose.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Samples\*.csv" LogicalName="Rose.Api.Samples.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rose.Api.IntegrationTests" />
  </ItemGroup>
</Project>