<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters: PostgreSQL (EF Core), Excel export / import (ClosedXML) and Web Push. -->
  <ItemGroup>
    <ProjectReference Include="..\Rose.Application\Rose.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Lib.Net.Http.WebPush" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rose.UnitTests" />
    <InternalsVisibleTo Include="Rose.Api.IntegrationTests" />
  </ItemGroup>
</Project>